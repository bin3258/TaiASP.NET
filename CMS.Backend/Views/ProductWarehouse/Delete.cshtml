@model CMS.Data.Entities.ProductWarehouse
@{
    Layout = "_LayoutAdmin";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">XÁC NHẬN XOÁ TỒN KHO</h4>
        </div>
        <div class="card-body">
            <p>Xoá tồn kho của sản phẩm <strong>@Model.Product?.Name</strong> tại kho <strong>@Model.Warehouse?.Name</strong>?</p>
            <table class="table table-bordered">
                <tr><th>Sản phẩm</th><td>@Model.Product?.Name</td></tr>
                <tr><th>Kho hàng</th><td>@Model.Warehouse?.Name (@Model.Warehouse?.Province)</td></tr>
                <tr><th>Tồn kho</th><td>@Model.StockQuantity</td></tr>
            </table>
            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Xác nhận xoá
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
