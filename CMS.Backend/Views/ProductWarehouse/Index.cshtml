@model IEnumerable<CMS.Data.Entities.ProductWarehouse>
@{
    Layout = "_LayoutAdmin";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                TỒN KHO THEO SẢN PHẨM
                @if (ViewBag.ProductName != null)
                {
                    <span>- @ViewBag.ProductName</span>
                }
            </h4>
            <a asp-action="Create" asp-route-productId="@ViewBag.ProductId" class="btn btn-light">
                + Thêm tồn kho
            </a>
        </div>
        <div class="card-body">
            <form method="get" class="row g-2 mb-3">
                <div class="col-auto">
                    <select name="productId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả sản phẩm --</option>
                        @foreach (var p in ViewBag.ProductList ?? new List<CMS.Data.Entities.Product>())
                        {
                            <option value="@p.Id" selected="@(ViewBag.ProductId?.ToString() == p.Id.ToString())">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Xoá lọc</a>
                </div>
            </form>

            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th width="60">ID</th>
                        <th>Sản phẩm</th>
                        <th>Kho hàng</th>
                        <th width="120">Tồn kho</th>
                        <th width="180">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Product?.Name</td>
                                <td>@item.Warehouse?.Name (@item.Warehouse?.Province)</td>
                                <td class="text-center"><strong>@item.StockQuantity</strong></td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm"
                                           onclick="return confirm('Xoá tồn kho này?')">Xóa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">Chưa có dữ liệu tồn kho</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
