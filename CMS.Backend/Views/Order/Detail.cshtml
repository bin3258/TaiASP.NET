@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    var warehouseList = (List<CMS.Data.Entities.Warehouse>)ViewBag.WarehouseList;
}

<div class="container mt-4">

    <h2>Chi tiết đơn hàng #@Model.Id</h2>

    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-3">
        <div class="card-header">
            Thông tin khách hàng
        </div>

        <div class="card-body">

            <p>
                <strong>Họ tên:</strong>
                @Model.Customer?.FullName
            </p>

            <p>
                <strong>Email:</strong>
                @Model.Customer?.Email
            </p>

            <p>
                <strong>Số điện thoại:</strong>
                @Model.Customer?.Phone
            </p>

            <p>
                <strong>Địa chỉ:</strong>
                @Model.Customer?.Address
            </p>

        </div>
    </div>

    <form method="post" action="@Url.Action("Confirm", new { id = Model.Id })" id="confirmForm">
        <div class="card">

            <div class="card-header">
                Danh sách sản phẩm
            </div>

            <div class="card-body p-0">

                <table class="table table-bordered mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            @if (Model.Status == 0)
                            {
                                <th>Kho xuất</th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            decimal total = 0;
                        }

                        @foreach (var item in Model.OrderDetails)
                        {
                            var subTotal = item.UnitPrice * item.Quantity;
                            total += subTotal;

                            <tr>

                                <td width="100">
                                    @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                    {
                                        <img src="/images/@item.Product.ImageUrl"
                                             width="80" />
                                    }
                                </td>

                                <td>
                                    @item.Product?.Name
                                </td>

                                <td>
                                    @item.UnitPrice.ToString("N0") VNĐ
                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    @subTotal.ToString("N0") VNĐ
                                </td>

                                @if (Model.Status == 0)
                                {
                                    <td>
                                        <select name="warehouses[@item.Id]" class="form-select" required>
                                            <option value="">-- Chọn kho --</option>
                                            @foreach (var w in warehouseList)
                                            {
                                                <option value="@w.Id">@w.Name (@w.Province)</option>
                                            }
                                        </select>
                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <td colspan="4" class="text-end">
                                <strong>Tổng tiền:</strong>
                            </td>

                            <td colspan="@(Model.Status == 0 ? 2 : 1)">
                                <strong class="text-danger">
                                    @total.ToString("N0") VNĐ
                                </strong>
                            </td>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>

        <div class="mt-3 d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary">
                Quay lại
            </a>

            @if (Model.Status == 0 && warehouseList != null && warehouseList.Any())
            {
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('Xác nhận duyệt đơn hàng và xuất kho?')">
                    Duyệt & Xuất kho
                </button>
            }
        </div>
    </form>

</div>
