@model CMS.Data.Entities.Warehouse
@{
    Layout = "_LayoutAdmin";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">SỬA KHO HÀNG</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên kho</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Province" class="form-label fw-bold">Tỉnh/Thành phố</label>
                        <input asp-for="Province" class="form-control" />
                        <span asp-validation-for="Province" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Address" class="form-label fw-bold">Địa chỉ</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label fw-bold">Điện thoại</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="Status" class="form-check-input" />
                        <label asp-for="Status" class="form-check-label">Đang hoạt động</label>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i> Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
